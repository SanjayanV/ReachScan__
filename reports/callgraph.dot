digraph ReachScan {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [color="#666666"];

  "load_config" [label="load_config", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "validate_config" [label="validate_config", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "startup_check" [label="startup_check", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "run_pipeline" [label="run_pipeline", shape=diamond, style=filled, fillcolor="#4f8ef7", fontcolor=white];
  "main" [label="main", shape=diamond, style=filled, fillcolor="#4f8ef7", fontcolor=white];
  "load_model_weights" [label="load_model_weights", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "batch_process" [label="batch_process", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "_internal_helper" [label="_internal_helper", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "process_image" [label="process_image", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "generate_thumbnail" [label="generate_thumbnail", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "fetch_data" [label="fetch_data", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "post_report" [label="post_report", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "render_dashboard" [label="render_dashboard", shape=ellipse, style=filled, fillcolor="#f0f0f0"];
  "__main__" [label="__main__", shape=diamond, style=filled, fillcolor="#4f8ef7", fontcolor=white];
  "yaml.load" [label="yaml.load", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];
  "config.keys" [label="keys", shape=ellipse, style=dashed, color="#999999"];
  "parser.add_argument" [label="add_argument", shape=ellipse, style=dashed, color="#999999"];
  "parser.parse_args" [label="parse_args", shape=ellipse, style=dashed, color="#999999"];
  "results.items" [label="items", shape=ellipse, style=dashed, color="#999999"];
  "numpy.load" [label="numpy.load", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];
  "fname.endswith" [label="endswith", shape=ellipse, style=dashed, color="#999999"];
  "results.append" [label="append", shape=ellipse, style=dashed, color="#999999"];
  "numpy.mean" [label="numpy.mean", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];
  "Image.open" [label="Image.open", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];
  "img.convert" [label="convert", shape=ellipse, style=dashed, color="#999999"];
  "img.thumbnail" [label="thumbnail", shape=ellipse, style=dashed, color="#999999"];
  "requests.get" [label="requests.get", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];
  "response.raise_for_status" [label="raise_for_status", shape=ellipse, style=dashed, color="#999999"];
  "response.json" [label="json", shape=ellipse, style=dashed, color="#999999"];
  "requests.post" [label="requests.post", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];
  "jinja2.Environment" [label="jinja2.Environment", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];
  "env.from_string" [label="from_string", shape=ellipse, style=dashed, color="#999999"];
  "template.render" [label="render", shape=ellipse, style=dashed, color="#999999"];
  "jinja2.select_autoescape" [label="jinja2.select_autoescape", shape=box, style=filled, fillcolor="#ff4757", fontcolor=white];

  "load_config" -> "yaml.load";
  "validate_config" -> "config.keys";
  "run_pipeline" -> "render_dashboard";
  "run_pipeline" -> "load_config";
  "run_pipeline" -> "validate_config";
  "run_pipeline" -> "process_image";
  "run_pipeline" -> "generate_thumbnail";
  "run_pipeline" -> "fetch_data";
  "run_pipeline" -> "post_report";
  "main" -> "parser.add_argument";
  "main" -> "parser.parse_args";
  "main" -> "run_pipeline";
  "main" -> "results.items";
  "load_model_weights" -> "numpy.load";
  "batch_process" -> "fname.endswith";
  "batch_process" -> "numpy.load";
  "batch_process" -> "results.append";
  "_internal_helper" -> "numpy.mean";
  "process_image" -> "Image.open";
  "process_image" -> "img.convert";
  "generate_thumbnail" -> "Image.open";
  "generate_thumbnail" -> "img.thumbnail";
  "fetch_data" -> "requests.get";
  "fetch_data" -> "response.raise_for_status";
  "fetch_data" -> "response.json";
  "post_report" -> "requests.post";
  "render_dashboard" -> "jinja2.Environment";
  "render_dashboard" -> "env.from_string";
  "render_dashboard" -> "template.render";
  "render_dashboard" -> "jinja2.select_autoescape";
  "__main__" -> "main";
}